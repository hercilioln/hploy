# Build output. The leading slash anchors to the repo root; without it "hploy"
# would also match cmd/hploy/.
/bin/
/dist/
/hploy

*.test
*.out
coverage.*

# Local state; the real one lives in ~/.hploy.
.hploy/

# Secrets stay out: the spec declares variable names, not values.
.env
*.env
!*.env.example

.idea/
.vscode/
*.swp
.DS_Store
